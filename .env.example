# ─────────────────────────────────────────────────────────────
# Karmic Ascension – environment variables
# Copy this file to .env.local and fill in your own values.
# NEVER commit .env.local or any real secret.
# ─────────────────────────────────────────────────────────────

# Public site URL (used for canonical URLs, sitemap, Open Graph)
# Local: http://localhost:3000   Production: https://neelabhshivam.com
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── Supabase (Project Settings → API) ────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
# Use the publishable/anon key. Either variable name works; the first one found is used.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=YOUR-PUBLISHABLE-OR-ANON-KEY
# NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-KEY

# SERVER ONLY. Required for the public booking operation (create_booking) and
# for the booking confirmation page. It is never sent to the browser.
# Do NOT prefix with NEXT_PUBLIC_. Do NOT commit it.
SUPABASE_SERVICE_ROLE_KEY=YOUR-SERVICE-ROLE-KEY

# ── Razorpay (NOT used yet — reserved for the later integration) ──
# The app runs without these. Manual payment is used until they are wired in.
# RAZORPAY_KEY_ID=
# RAZORPAY_KEY_SECRET=
# RAZORPAY_WEBHOOK_SECRET=

# ── New-booking e-mail alerts (optional) ─────────────────────
# Create a free account at https://resend.com, verify your domain, create an API key.
# Without RESEND_API_KEY nothing is sent and bookings still work normally.
# RESEND_API_KEY=
# Sender must be on a domain verified in Resend, e.g. "Karmic Ascension <bookings@neelabhshivam.com>"
# NOTIFY_FROM_EMAIL=
# Optional: overrides Admin → Settings → Alert e-mail
# ADMIN_NOTIFY_EMAIL=
